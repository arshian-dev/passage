# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL)
DATABASE_URL=postgresql://<user>:<password>@<ep-xyz>.<region>.aws.neon.tech/<dbname>?sslmode=require

# OpenAI API Key (Entity Extraction, Conversational Agent)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Optional: Pinecone Vector Database (RAG Knowledge Base)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=immigration-kb

# Optional: Frontend API URL (defaults to http://127.0.0.1:8000 if omitted)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
